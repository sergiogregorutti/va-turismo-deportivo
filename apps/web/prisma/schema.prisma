generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum Country {
  ARGENTINA
  VENEZUELA
}

enum Modality {
  PRACTICAR
  COMPETIR
  PRESENCIAR
}

enum City {
  BUENOS_AIRES
  BARILOCHE
  CORDOBA
  LOS_ROQUES
  MARGARITA
  LA_GRAN_SABANA
}

enum Formato {
  LIFESTYLE
  CORPORATIVO
  EQUIPOS
}

enum ServiceCategory {
  TRANSPORTE
  CONCIERGE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Discipline {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  description String?
  imageUrl    String?
  modalities  Modality[]
  countries   Country[]
  cities      City[]
  experiences Experience[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Experience {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  description  String     @db.Text
  country      Country
  city         City?
  location     String
  modality     Modality
  formato      Formato?
  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id])
  imageUrls    String[]
  startDate    DateTime?
  endDate      DateTime?
  priceInfo    String?
  externalUrl  String?
  featured     Boolean    @default(false)
  published    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([country])
  @@index([city])
  @@index([modality])
  @@index([formato])
  @@index([disciplineId])
  @@index([published])
  @@index([featured])
}

model Hospedaje {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  country     Country
  city        City?
  location    String
  imageUrls   String[]
  priceInfo   String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([country])
  @@index([city])
  @@index([published])
  @@index([featured])
}

model CityPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  province     String
  country      Country
  imageUrl     String
  heroImageUrl String?
  tagline      String
  intro        String   @db.Text
  about        String   @db.Text
  climate      String   @db.Text
  bestSeasons  String[]
  sports       String[]
  highlights   Json     @default("[]")
  gettingThere String   @db.Text
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([country, published])
}

model HeroSlide {
  id        String   @id @default(cuid())
  country   Country
  imageUrl  String
  alt       String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country, published])
}

model Aliado {
  id        String   @id @default(cuid())
  name      String
  tag       String?
  logoUrl   String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModalityPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  modality        Modality
  title           String
  tagline         String
  heroDescription String   @db.Text
  description     String   @db.Text
  highlights      Json     @default("[]")
  ctaLabel        String
  whatsappMessage String   @db.Text
  metaDescription String   @db.Text
  updatedAt       DateTime @updatedAt
}

model ServiceItem {
  id          String          @id @default(cuid())
  category    ServiceCategory
  title       String
  description String          @db.Text
  imageUrl    String
  badge       String?
  order       Int             @default(0)
  published   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, published])
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model ContactLead {
  id          String   @id @default(cuid())
  name        String
  email       String?
  cityCountry String?
  services    String?
  date        String?
  message     String?  @db.Text
  createdAt   DateTime @default(now())
}
