# Base de datos (Neon Postgres)
DATABASE_URL="postgresql://user:password@host-pooler:5432/vaturismodeportivo?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/vaturismodeportivo?sslmode=require"

# Subida de imagenes (Vercel Blob)
# Se inyecta automaticamente al crear un Blob store en el proyecto de Vercel.
# Para desarrollo local: `vercel env pull` o copiar el token desde el dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Auth del backoffice (admin). Generar con: openssl rand -base64 32
# Sin esta variable se usa un secreto de desarrollo inseguro.
JWT_SECRET="cambiar-en-produccion"
